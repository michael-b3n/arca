// Generated from tools/cmake/embedded_scripts.cpp.in by configure_embedded_scripts.
#include "@EMBED_HEADER@"

#include <algorithm>
#include <array>
#include <bit>
#include <cstddef>
#include <optional>
#include <span>
#include <string_view>

// #embed is standard in C++26, clang still calls it an extension
#ifdef __clang__
  #pragma clang diagnostic ignored "-Wc23-extensions"
#endif

namespace @EMBED_NAMESPACE@
{
namespace
{

///
/// \return \p bytes as characters, #embed gives numbers a char can not hold above 127
///
template<std::size_t N>
[[nodiscard]] consteval auto to_text(const unsigned char (&bytes)[N]) -> std::array<char, N>
{
  return std::bit_cast<std::array<char, N>>(bytes);
}

// Each script ends with a 0 that is no part of its code, so an empty one is an array too
// clang-format off
@EMBED_DECLARATIONS@
constexpr auto scripts = std::array<arcstd::lua::embedded_script, @EMBED_COUNT@>{{
@EMBED_ENTRIES@
}};
// clang-format on

} // namespace

///
///
auto all() -> std::span<const arcstd::lua::embedded_script>
{
  return scripts;
}

///
///
auto find(const std::string_view name) -> std::optional<arcstd::lua::embedded_script>
{
  const auto it = std::ranges::find(scripts, name, &arcstd::lua::embedded_script::name);
  return it != std::ranges::end(scripts) ? std::optional{*it} : std::nullopt;
}

} // namespace @EMBED_NAMESPACE@
