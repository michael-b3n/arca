{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 3,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "ARCA_STATIC_DEPENDENCIES": "OFF",
        "ARCA_COVERAGE": "OFF",
        "CMAKE_EXE_LINKER_FLAGS": ""
      }
    },
    {
      "name": "clang",
      "hidden": true,
      "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "gcc",
      "hidden": true,
      "cacheVariables": { "CMAKE_CXX_COMPILER": "g++" }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "static",
      "hidden": true,
      "cacheVariables": {
        "ARCA_STATIC_DEPENDENCIES": "ON",
        "CMAKE_EXE_LINKER_FLAGS": "-static"
      }
    },
    {
      "name": "coverage",
      "hidden": true,
      "cacheVariables": { "ARCA_COVERAGE": "ON" }
    },
    { "name": "clang-debug", "displayName": "Clang Debug", "inherits": ["base", "clang", "debug"] },
    { "name": "clang-release", "displayName": "Clang Release", "inherits": ["base", "clang", "release"] },
    { "name": "gcc-debug", "displayName": "GCC Debug", "inherits": ["base", "gcc", "debug"] },
    { "name": "gcc-release", "displayName": "GCC Release", "inherits": ["base", "gcc", "release"] },
    {
      "name": "gcc-release-static",
      "displayName": "GCC Release Static",
      "inherits": ["static", "base", "gcc", "release"]
    },
    {
      "name": "gcc-coverage",
      "displayName": "GCC Coverage",
      "inherits": ["coverage", "base", "gcc", "debug"]
    }
  ],
  "buildPresets": [
    { "name": "clang-debug", "configurePreset": "clang-debug" },
    { "name": "clang-release", "configurePreset": "clang-release" },
    { "name": "gcc-debug", "configurePreset": "gcc-debug" },
    { "name": "gcc-release", "configurePreset": "gcc-release" },
    { "name": "gcc-release-static", "configurePreset": "gcc-release-static" },
    { "name": "gcc-coverage", "configurePreset": "gcc-coverage" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "clang-debug", "inherits": "base", "configurePreset": "clang-debug" },
    { "name": "clang-release", "inherits": "base", "configurePreset": "clang-release" },
    { "name": "gcc-debug", "inherits": "base", "configurePreset": "gcc-debug" },
    { "name": "gcc-release", "inherits": "base", "configurePreset": "gcc-release" },
    { "name": "gcc-release-static", "inherits": "base", "configurePreset": "gcc-release-static" },
    { "name": "gcc-coverage", "inherits": "base", "configurePreset": "gcc-coverage" }
  ]
}
